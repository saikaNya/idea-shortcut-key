{
  "name": "idea-shortcut-key",
  "displayName": "idea-shortcut-key",
  "description": "idea shortcut key",
  "version": "0.0.1",
  "publisher": "saika",
  "repository": {
    "type": "git",
    "url": "https://github.com/saikaNya/idea-shortcut-key.git"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "idea-shortcut-key.fqn",
        "title": "get FQN"
      },
      {
        "command": "idea-shortcut-key.copyFileFQN",
        "title": "Copy File FQN"
      }
    ],
    "keybindings": [
      {
        "command": "idea-shortcut-key.fqn",
        "key": "ctrl+alt+shift+c",
        "mac": "cmd+alt+shift+c",
        "when": "editorTextFocus"
      },
      {
        "command": "idea-shortcut-key.copyFileFQN",
        "key": "ctrl+alt+shift+c",
        "mac": "cmd+alt+shift+c",
        "when": "explorerViewletVisible && filesExplorerFocus"
      },
      {
        "command": "idea-shortcut-key.copyFileFQN",
        "key": "ctrl+alt+shift+c",
        "mac": "cmd+alt+shift+c",
        "when": "listFocus && explorerViewletVisible"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "idea-shortcut-key.copyFileFQN",
          "when": "resourceExtname == .java",
          "group": "5_cutcopypaste"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "pnpm run check-types && pnpm run lint && node esbuild.js",
    "package-extension": "cross-env npm_config_user_agent=pnpm vsce package --no-dependencies",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "pnpm run check-types && pnpm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "1.95.0",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.4.2",
    "esbuild": "^0.25.3",
    "eslint": "^9.25.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.8.3"
  }
}
